@startuml
!include <C4/C4_Component>
!include common_c4.iuml
skinparam wrapWidth 200
LAYOUT_TOP_DOWN()

Person(resident, "Residente", "Hace consultas al asistente.")
Person(admin, "Administrador", "Atiende las consultas derivadas.")
Container(spa, "BuildingFex Web SPA", "Vue 3", "Interfaz web para administradores y residentes.")
Component_Ext(communications, "Módulo Communications", "ImportUploadsController", "Encola el documento confirmado o publicado y retira el archivado.")
Container(jobs, "Función de jobs", "AWS Lambda + EventBridge", "Job ai-index: invocación asíncrona y barrido cada 30 min.")

Container_Boundary(api, "BuildingFex.Api - módulo Resident Care") {
  Component(rcCtrl, "SupportController", "ASP.NET Core API Controller", "/api/v1/support: chats, mensajes, estado, cierre, uso de IA y «Reportar como incidencia». Filtra la pregunta, aplica cupos, recupera contexto, genera la respuesta y deriva al administrador.")
  Component(rcHub, "SupportHub", "SignalR (/hubs/support, solo en local)", "Avisos en vivo de mensajes y derivaciones; en AWS el chat usa polling.")
  Component(policies, "Políticas del dominio", "Domain Services", "QuestionRelevancePolicy, AnswerPolicy, SupportEscalate y ResidentAssistantPrompt.")
  Component(quota, "AiUsageQuota", "C# Application Service", "Tope mensual por condominio (ai_usages) y diario por residente (resident_ai_usages).")
  Component(planQuota, "PlanQuotaClient", "Anticorruption Layer", "Tope de consultas y módulos del plan, publicado por Billing.")
  Component(indexer, "AiContextIndexer", "C# Application Service", "Divide el documento, guarda embeddings en ai_context_chunks y recupera los fragmentos más parecidos.")
  Component(indexJob, "AiContextIndexingJob", "C# Application Service", "Indexa los pendientes; en local lo dispara AiContextIndexingWorker desde AiContextIndexingQueue.")
  Component(notifier, "IncidentResolutionNotifier", "C# Application Service", "Implementa IIncidentResolutionNotifier: deja un aviso en el chat de origen.")
}

Component_Ext(gateway, "Gateway de IA", "GeminiClient, GeminiEmbeddingClient y GeminiRateLimiter", "Único acceso a Gemini.")
System_Ext(gemini, "Google Gemini API", "Proveedor de IA externo.")
Component_Ext(incidents, "Módulo Incidents", "IncidentCommandService e IncidentTriageService", "Registra la incidencia del chat y avisa al resolverla.")
Component_Ext(billing, "Módulo Billing", "SubscriptionPlans y PlanCatalog", "Plan efectivo y tope mensual de consultas.")
Component_Ext(storage, "File Storage", "S3StorageService", "Descarga del documento.")
ContainerDb(db, "Base de datos TiDB Cloud", "TiDB Cloud Starter (compatible con MySQL)", "Esquema de Resident Care: support_chats, support_messages, ai_context_chunks, ai_usages y resident_ai_usages.")

Rel(resident, spa, "Consulta al asistente", "HTTPS")
Rel(admin, spa, "Responde consultas derivadas", "HTTPS")
Rel(spa, rcCtrl, "Usa; en AWS, polling del chat", "JSON/HTTPS")
Rel(spa, rcHub, "Avisos (local)", "WSS")
Rel(rcCtrl, policies, "Aplica")
Rel(rcCtrl, quota, "Reserva y libera cupo")
Rel(rcCtrl, planQuota, "Tope del plan")
Rel(rcCtrl, indexer, "RetrieveAsync")
Rel(rcCtrl, gateway, "GenerateReplyAsync")
Rel(rcCtrl, rcHub, "Avisa")
Rel(rcCtrl, incidents, "CreateIncidentCommand")
Rel(incidents, notifier, "NotifyResolvedAsync")
Rel(communications, indexJob, "IAiContextIndexingQueue (ai-index)")
Rel(communications, indexer, "RemoveUploadAsync")
Rel(jobs, indexJob, "Ejecuta ai-index")
Rel(indexJob, indexer, "IndexUploadAsync")
Rel(indexer, gateway, "EmbedAsync")
Rel(indexer, storage, "DownloadBytesAsync")
Rel(planQuota, billing, "Lee el plan")
Rel(gateway, gemini, "generateContent y embeddings", "HTTPS")
Rel(rcCtrl, db, "Chats y mensajes (AppDbContext)", "EF Core")
Rel(quota, db, "Lee y escribe", "EF Core")
Rel(indexer, db, "Lee y escribe", "EF Core")
Rel(notifier, db, "Escribe el aviso", "EF Core")
@enduml
