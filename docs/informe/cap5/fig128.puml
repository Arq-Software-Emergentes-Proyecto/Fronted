@startuml
skinparam dpi 200
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
hide circle
hide methods
skinparam class {
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #E7EDF8
  BorderColor #1F3864
  ArrowColor #181818
}
skinparam class<<ext>> {
  BackgroundColor #F2F2F2
  HeaderBackgroundColor #D9D9D9
  BorderColor #8A8A8A
}
hide stereotype
title Bounded Context Team - Database Design (TiDB Cloud · compatible con MySQL)

entity team_workers {
  * id : INT «PK» AUTO_INCREMENT
  --
  external_id : VARCHAR(128) «UQ»
  owner_admin_id : VARCHAR(128)
  name : VARCHAR(256)
  phone : VARCHAR(64)
  dni : VARCHAR(32)
  salary : DECIMAL(18,2)
  photo_url : LONGTEXT
  position : VARCHAR(20)
  status : VARCHAR(20)
  deactivated_at : DATETIME(6)
  created_at : DATETIME(6)
}

entity maintenance_tasks {
  * id : INT «PK» AUTO_INCREMENT
  --
  external_id : VARCHAR(128) «UQ»
  owner_admin_id : VARCHAR(128)
  staff_id : VARCHAR(128)
  incident_id : VARCHAR(128) «IDX»
  description : VARCHAR(2000)
  scheduled_for : DATETIME(6)
  status : VARCHAR(20)
  started_at : DATETIME(6)
  completed_at : DATETIME(6)
  created_at : DATETIME(6)
  updated_at : DATETIME(6)
  ..
  «IDX» (owner_admin_id, staff_id, status)
}

entity shifts {
  * id : INT «PK» AUTO_INCREMENT
  --
  external_id : VARCHAR(128) «UQ»
  owner_admin_id : VARCHAR(128)
  staff_id : VARCHAR(128)
  starts_at : DATETIME(6)
  ends_at : DATETIME(6)
  notes : VARCHAR(500)
  created_at : DATETIME(6)
  ..
  «IDX» (owner_admin_id, staff_id, starts_at)
}

team_workers "1   " .. "0..*" maintenance_tasks : staff_id → external_id\n(sin FK)
team_workers "   1" .. "0..*   " shifts : staff_id → external_id\n(sin FK)
@enduml
