@startuml
!include common_class.iuml
top to bottom direction
hide empty members
title Bounded Context Profiles - Domain Layer

class Building <<Aggregate Root>> {
  {static} +NameMaxLength : int = 200
  {static} +AddressMaxLength : int = 500
  {static} +MaxDepartmentCount : int = 5000
  -id : int
  -ownerAdminId : int
  -name : string
  -address : string
  -departmentCount : int
  -createdAt : DateTimeOffset?
  -updatedAt : DateTimeOffset?
  --
  +{static} Register(...): Building
  +Update(name, address, departmentCount): void
  +{static} Validate(...): Dictionary<string, string[]>
}

class Profile <<Aggregate Root>> {
  -id : int
  -userExternalId : string
  -name : string
  -email : string
  -dni : string?
  -address : string?
  -company : string?
  -ruc : string?
  -createdAt : DateTimeOffset?
  -updatedAt : DateTimeOffset?
  --
  +{static} Create(...): Profile
  +Update(name, email?, dni?, address?, company?, ruc?): void
}

interface IBuildingRepository <<Repository>> {
  +ListByOwnerAdminIdAsync(ownerAdminId): IReadOnlyList<Building>
  +SumDepartmentsByOwnerAdminIdAsync(ownerAdminId): int
}

interface "IBaseRepository<TEntity>" as IBaseRepository <<Repository · Shared>> {
  +AddAsync(entity): Task
  +FindByIdAsync(id): TEntity?
  +Update(entity): void
  +Remove(entity): void
  +ListAsync(): IEnumerable<TEntity>
}

interface IAuditableEntity <<Shared>> {
  +CreatedAt : DateTimeOffset?
  +UpdatedAt : DateTimeOffset?
}

class User <<Aggregate Root · IAM>> #F2F2F2 {
  -id : int
  -externalId : string
}

note bottom of User
  Agregado de IAM (referenciado solo
  por identificador). El padrón de
  residentes, sus departamentos y sus
  invitaciones viven en User.
end note

IBuildingRepository -|> IBaseRepository : TEntity = Building
IBuildingRepository ..> "0..*" Building : persiste
Building ..|> IAuditableEntity
Profile ..|> IAuditableEntity
Building "0..*" --> "1" User : ownerAdminId\n(users.id)
Profile "0..1" --> "1" User : userExternalId\n(users.external_id)
@enduml
