@startuml
!include common_class.iuml
left to right direction
hide circle
hide methods
title Finances - Database Design (2 de 2: configuración, gastos y cargos)





entity finance_settings {
  * id : INT «PK, AUTO_INCREMENT»
  --
  external_id : VARCHAR(64) «UQ»
  owner_admin_id : INT «FK»
  base_monthly_expense : DECIMAL(18,2)
  late_fee_rate : DECIMAL(8,4)
  late_fee_per_day : DECIMAL(18,2)
  admission_pay_from_day : INT
  admission_pay_to_day : INT
  monthly_charges_json : LONGTEXT
  restrict_reservations_when_delinquent : TINYINT(1)
  created_at : DATETIME(6)
  updated_at : DATETIME(6)
}

entity "users (IAM)" as users #F2F2F2 {
  * id : INT «PK»
  --
  external_id : VARCHAR(128) «UQ»
  ...
}

entity kpi_records {
  * id : INT «PK, AUTO_INCREMENT»
  --
  external_id : VARCHAR(64) «UQ»
  owner_admin_id : INT «FK»
  total_residents : INT
  occupied_units : INT
  empty_units : INT
  total_debt : DECIMAL(18,2)
  created_at : DATETIME(6)
  updated_at : DATETIME(6)
}

entity admin_management_expenses {
  * id : INT «PK, AUTO_INCREMENT»
  --
  external_id : VARCHAR(64) «UQ»
  owner_admin_id : INT «FK»
  name : VARCHAR(200)
  amount : DECIMAL(18,2)
  purchase_date : VARCHAR(20)
  invoice_photo_url : LONGTEXT
  created_at : DATETIME(6)
  updated_at : DATETIME(6)
}

entity shared_utility_services {
  * id : INT «PK, AUTO_INCREMENT»
  --
  external_id : VARCHAR(64) «UQ»
  owner_admin_id : INT «FK»
  type : VARCHAR(40)
  amount : DECIMAL(18,2)
  month : VARCHAR(10)
  resident_count : INT
  per_resident_share : DECIMAL(18,2)
  created_at : DATETIME(6)
  updated_at : DATETIME(6)
}

entity fixed_payout_recipients {
  * id : INT «PK, AUTO_INCREMENT»
  --
  external_id : VARCHAR(64) «UQ»
  owner_admin_id : INT «FK»
  name : VARCHAR(200)
  dni : VARCHAR(80)
  phone : VARCHAR(40)
  salary : DECIMAL(18,2)
  interval_days : INT
  next_payment_date : VARCHAR(20)
  photo_url : LONGTEXT
  payment_history_json : LONGTEXT
  created_at_iso : VARCHAR(40)
  created_at : DATETIME(6)
  updated_at : DATETIME(6)
}

entity resident_extra_charges {
  * id : INT «PK, AUTO_INCREMENT»
  --
  external_id : VARCHAR(128) «UQ»
  owner_admin_id : VARCHAR(128)
  resident_id : VARCHAR(128)
  title : VARCHAR(256)
  amount : DECIMAL(18,2)
  description : LONGTEXT
  created_at : DATETIME(6)
}

users "1" -[norank]- "0..*" finance_settings
users "1" -[norank]- "0..*" kpi_records
users "1" -[norank]- "0..*" admin_management_expenses
users "1" -[norank]- "0..*" shared_utility_services
users "1" -[norank]- "0..*" fixed_payout_recipients

note as N1
  TiDB Cloud (compatible con MySQL).
  Las líneas hacia users son la FK
  owner_admin_id → users.id
  (ON DELETE RESTRICT).
  resident_extra_charges guarda los
  identificadores externos del
  condominio y del residente como
  texto (sin FK).
end note
' --- disposición en columnas (aristas ocultas); las relaciones usan [norank]
users -[hidden]- finance_settings
users -[hidden]- admin_management_expenses
users -[hidden]- shared_utility_services
users -[hidden]- fixed_payout_recipients

@enduml
