// Figura 83 (v2) - Context Map. Cambios: "Google OAuth" -> Firebase Authentication (el ingreso con Google pasa por Firebase);
// disposición vertical y etiquetas de relación más grandes.
digraph CM {
  rankdir=TB; splines=true; nodesep=0.35; ranksep=0.55; pad=0.15; newrank=true;
  node [shape=box, style="filled", fontname="Liberation Sans", fontsize=17, color="#1F3864", penwidth=1.2, width=1.9, height=0.75, margin="0.12,0.06"];
  edge [color="#1F3864", fontname="Liberation Sans", fontsize=15, arrowsize=0.8, penwidth=1.3];
  FB  [label=<Firebase<br/>Authentication<br/><i>externo</i>>, fillcolor=white, color="#999999", style="dashed"];
  MP  [label=<Mercado Pago<br/><i>externo</i>>, fillcolor=white, color="#999999", style="dashed"];
  IA  [label=<Proveedor de IA -<br/>Gemini<br/><i>externo</i>>, fillcolor=white, color="#999999", style="dashed"];
  IAM [label=<IAM<br/><i>generic</i>>, fillcolor="#F2F2F2", color="#999999"];
  BIL [label=<Billing<br/><i>generic</i>>, fillcolor="#F2F2F2", color="#999999"];
  PRO [label=<Profiles<br/><i>supporting</i>>, fillcolor="#DCE3EE"];
  FIN [label=<Finances<br/><i>supporting</i>>, fillcolor="#DCE3EE"];
  SS  [label=<Social Spaces<br/><i>supporting</i>>, fillcolor="#DCE3EE"];
  COM [label=<Communications<br/><i>supporting</i>>, fillcolor="#DCE3EE"];
  TEAM[label=<Team<br/><i>supporting</i>>, fillcolor="#DCE3EE"];
  INC [label=<<font color="white">Incidents<br/><i>core</i></font>>, fillcolor="#1F3864"];
  RC  [label=<<font color="white">Resident Care<br/><i>core</i></font>>, fillcolor="#1F3864"];
  NOTE [shape=note, fillcolor="#FFFDE7", color="#8A8A8A", fontsize=15, margin="0.12,0.08",
        label=<IAM es upstream (OHS + PL: JWT<br align="left"/>y edificio activo) de <b>todos</b> los<br align="left"/>contextos; por claridad solo se<br align="left"/>dibuja la relación con Profiles.<br align="left"/>U: upstream · D: downstream ·<br align="left"/>C/S: cliente-proveedor · ACL:<br align="left"/>capa anticorrupción · OHS: servicio<br align="left"/>abierto · PL: lenguaje publicado<br align="left"/>>];

  { rank=same; FB; MP; IA; }
  { rank=same; IAM; BIL; COM; }
  { rank=same; PRO; INC; }
  { rank=same; FIN; TEAM; RC; }
  { rank=same; SS; NOTE; }
  FB -> MP -> IA [style=invis];
  IAM -> BIL -> COM [style=invis];

  FB  -> IAM [label="U: API (ID token,\nAdmin SDK) / D: ACL"];
  MP  -> BIL [label="U: API / D: ACL"];
  MP  -> FIN [label="U: API / D: ACL"];
  IA  -> INC [label="U: API / D: ACL"];
  IA  -> RC  [label="U: API / D: ACL"];
  IAM -> PRO [label="U: OHS + PL /\nD: todos los\ncontextos"];
  BIL -> PRO [label="C/S (límite de\ndepartamentos)"];
  BIL -> RC  [label="C/S + PL (tope de IA,\nPlanQuotaClient)"];
  PRO -> FIN [label="C/S"];
  PRO -> RC  [label="C/S"];
  PRO -> SS  [label="C/S"];
  FIN -> SS  [label="C/S (estado\nde cuenta)"];
  COM -> RC  [label="C/S + PL"];
  INC -> RC  [label="C/S"];
  INC -> TEAM[label="C/S"];
}
