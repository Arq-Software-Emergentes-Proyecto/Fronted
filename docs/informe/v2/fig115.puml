@startuml
!include common_class.iuml
left to right direction
hide empty members
title Bounded Context Billing - Domain Layer

interface ISubscriptionRepository <<Repository>> {
  +FindByOwnerAdminIdAsync(...)
  +FindPaymentByMpIdAsync(...)
  +AddPaymentAsync(payment): void
  +FindCheckoutAsync(...)
  +AddCheckoutAsync(...): void
  +ReloadAsync(entity): void
  +Detach(entity): void
}

class Subscription <<Aggregate Root>> {
  -id : int
  -ownerAdminId : int
  -buildingId : int?
  -planId : string
  -status : string
  -trialEndsAt : DateTimeOffset?
  -paidUntil : DateTimeOffset?
  -failedCharges : int
  -billedDepartments : int?
  -createdAt : DateTimeOffset?
  -updatedAt : DateTimeOffset?
  --
  +{static} StartTrial(...)
  +{static} FromLegacy(...)
  +Activate(...): void
  +ChangeToFree(): void
  +RegisterFailedCharge(): void
  +Cancel(): void
  +LinkBuilding(buildingId): void
  +IsTrialExpired(now): bool
  +EffectiveStatus(now): string
  +RequiresPlanSelection(...)
  +AllowsRosterGrowth(now): bool
  +NextPaidUntil(...)
  +TrialDaysLeft(now): int?
  +Limits(): PlanLimits
  +EffectiveLimits(...)
}

class SubscriptionPayment <<Entity>> {
  -id : int
  -mpPaymentId : string
  -ownerAdminId : int
  -planId : string
  -amount : decimal
  -expectedAmount : decimal
  -currency : string?
  -departmentCount : int?
  -checkoutExternalId : string?
  -status : string
  -source : string
  -paidUntil : DateTimeOffset?
  -createdAt : DateTimeOffset?
  -updatedAt : DateTimeOffset?
  --
  +{static} Create(...)
  +IsApplied : bool
}

class SubscriptionCheckout <<Entity>> {
  -id : int
  -externalId : string
  -ownerAdminId : int
  -planId : string
  -departmentCount : int?
  -amount : decimal
  -status : string
  -mpPaymentId : string?
  -createdAt : DateTimeOffset?
  -updatedAt : DateTimeOffset?
  --
  +{static} Create(...)
  +MarkPaid(mpPaymentId): void
}

class PlanLimits <<Value Object>> {
  -maxDepartments : int
  -monthlyAiQueries : int
  --
  +{static} For(...): PlanLimits
  +AllowsDepartments(...): bool
  +AllowsAiQuery(...): bool
}

class SubscriptionPlans <<static>> {
  +FreeTrialDays = 30
  +PaidGraceDays = 5
  +PaidPeriodDays = 31
  +PortafolioPricePerDepartmentPen = 4
  +PortafolioMinimumPen = 600
  --
  +MaxResidents(planId): int
  +MonthlyPricePen(...): decimal
  +MonthlyAiQueryCap(planId): int
  +IsPaid(planId): bool
  +EffectivePlanId(...): string
}

enum SubscriptionPlanIds <<constantes string>> {
  free
  essential
  standard
  scale
  portafolio
}

enum SubscriptionStatus <<constantes string>> {
  TRIAL
  ACTIVE
  PAYMENT_FAILED
  SUSPENDED
  CANCELLED
}

enum SubscriptionPaymentStatus <<constantes string>> {
  APPLIED
  REVIEW_AMOUNT_MISMATCH
}

note bottom of SubscriptionPayment
  Se relaciona con Subscription por
  ownerAdminId (sin clave foránea entre
  ambas); mpPaymentId es único.
end note

ISubscriptionRepository .[norank].> "0..1" Subscription : persiste
ISubscriptionRepository .[norank].> "*" SubscriptionPayment : registra
ISubscriptionRepository .[norank].> "*" SubscriptionCheckout : registra
Subscription "1" -[norank]- "0..*" SubscriptionPayment : ownerAdminId
Subscription "1" -[norank]- "0..*" SubscriptionCheckout : ownerAdminId
SubscriptionCheckout "1" .[norank]. "0..1" SubscriptionPayment : checkoutExternalId
Subscription .[norank].> "1" PlanLimits : Limits()
PlanLimits .[norank].> SubscriptionPlans : For()
Subscription "*" -[norank]-> "1" SubscriptionPlanIds : planId
Subscription "*" -[norank]-> "1" SubscriptionStatus : status
SubscriptionPayment "*" -[norank]-> "1" SubscriptionPaymentStatus : status
' --- disposición en columnas (aristas ocultas); las relaciones usan [norank]
ISubscriptionRepository -[hidden]- Subscription
Subscription -[hidden]- SubscriptionPayment
Subscription -[hidden]- PlanLimits
Subscription -[hidden]- SubscriptionPlans
Subscription -[hidden]- SubscriptionPlanIds
Subscription -[hidden]- SubscriptionStatus
Subscription -[hidden]- SubscriptionPaymentStatus
@enduml
