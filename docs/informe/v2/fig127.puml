@startuml
!include common_class.iuml
top to bottom direction
hide empty members
title Bounded Context Team - Domain Layer

class TeamWorker <<Aggregate Root>> {
  -id : int
  -externalId : string
  -ownerAdminId : string
  -name : string
  -phone : string
  -dni : string
  -salary : decimal
  -photoUrl : string
  -position : string
  -status : string
  -deactivatedAt : DateTimeOffset?
  -createdAt : DateTimeOffset
  --
  +IsActive : bool
  +{static} Create(...): TeamWorker
  +UpdateDetails(...): void
  +Deactivate(): void
  +Reactivate(): void
}

class MaintenanceTask <<Aggregate Root>> {
  -id : int
  -externalId : string
  -ownerAdminId : string
  -staffId : string
  -incidentId : string?
  -description : string
  -scheduledFor : DateTimeOffset?
  -status : string
  -startedAt : DateTimeOffset?
  -completedAt : DateTimeOffset?
  -createdAt : DateTimeOffset
  -updatedAt : DateTimeOffset?
  --
  +IsOpen : bool
  +{static} Create(...): MaintenanceTask
  +AssignTo(staffId): void
  +Start(): void
  +Complete(): void
  +Reassign(staffId): void
  +Reschedule(...): void
}

class Shift <<Entity>> {
  -id : int
  -externalId : string
  -ownerAdminId : string
  -staffId : string
  -startsAt : DateTimeOffset
  -endsAt : DateTimeOffset
  -notes : string?
  -createdAt : DateTimeOffset
  --
  +{static} Create(...): Shift
  +Reschedule(start, end, notes): void
  +{static} EnsureValidRange(...): void
  +Overlaps(other): bool
}

class WorkloadPolicy <<Domain Service>> {
  +MaxOpenTasksPerWorker : int = 10
  +CanTakeTask(...): WorkloadViolation
}

enum WorkloadViolation {
  None
  WorkerInactive
  MaxOpenTasksReached
}

enum StaffPosition <<constantes>> {
  CONCIERGE
  MAINTENANCE
  CLEANING
  SECURITY
}

enum StaffStatus <<constantes>> {
  ACTIVE
  INACTIVE
}

enum MaintenanceTaskStatus <<constantes>> {
  PENDING
  IN_PROGRESS
  COMPLETED
}

interface ITeamWorkerRepository <<Repository>> {
  +FindByIdentifierAsync(id): TeamWorker?
  +FindInTenantAsync(...): TeamWorker?
  +ListByOwnerAsync(...)
}

interface IMaintenanceTaskRepository <<Repository>> {
  +FindInTenantAsync(...)
  +ListAsync(...)
  +FindOpenByStaffAsync(...)
  +CountOpenByStaffAsync(...): int
  +CountOpenGroupedByStaffAsync(...)
}

interface IShiftRepository <<Repository>> {
  +FindInTenantAsync(...): Shift?
  +ListAsync(...): IReadOnlyList<Shift>
  +FindOverlappingAsync(...)
  +ListByStaffAsync(...)
}

TeamWorker "1" <-- "0..*" MaintenanceTask : staffId
TeamWorker "1" <-- "0..*" Shift : staffId
TeamWorker "*" --> "1" StaffPosition : position
TeamWorker "*" --> "1" StaffStatus : status
MaintenanceTask "*" --> "1" MaintenanceTaskStatus : status
WorkloadPolicy ..> "1" TeamWorker : evalúa
WorkloadPolicy ..> WorkloadViolation : devuelve
ITeamWorkerRepository ..> "*" TeamWorker : persiste
IMaintenanceTaskRepository ..> "*" MaintenanceTask : persiste
IShiftRepository ..> "*" Shift : persiste
@enduml
