@startuml
!$TECHN_FONT_SIZE = 14
!include <C4/C4_Component>
!include common_c4.iuml
skinparam wrapWidth 128
LAYOUT_TOP_DOWN()
' Componentes de BuildingFex.Api - bounded context IAM (sin Container_Boundary para compactar)

Container(spa, "BuildingFex Web SPA", "Vue 3", "Envía el idToken de Firebase y X-Building-Id.")
Component(mw, "AccountStatus / BoardReadOnly Middleware", "Middleware", "403 ACCOUNT_\nDEACTIVATED y 403 BOARD_READ_\nONLY (junta).")

Component(authCtrl, "Authentication Controller", "REST Controller", "/api/v1/ authentication: me, sign-in-google, residents/invite, complete-google.")
Component(usersCtrl, "UsersController", "REST Controller", "/api/v1/users: GET, POST; {id}: GET, PATCH, DELETE; deactivate y reactivate.")
Component(memCtrl, "Members Controller", "REST Controller", "/api/v1/members: GET; POST y DELETE invitations; DELETE {userId}.")
Component(minvCtrl, "MemberInvitations Controller", "REST Controller", "/api/v1/member-\ninvitations/{token}: GET (público) y POST accept.")

Component(ucs, "UserCommand Service", "Application Service", "SignInGoogle, Complete ResidentGoogle, UpsertFirebase Admin, Create/ Patch/Delete Resident, Deactivate/ Reactivate Account.")
Component(uqs, "UserQuery Service", "Application Service", "GetByExternalId, GetAll, GetResidents ByOwner ExternalId, Search.")
Component(cca, "CallerContext Accessor", "Servicio de tenancy", "Usuario, edificio activo y rol (owner, admin, board_member, resident).")
Component_Ext(others, "Profiles, Finances y otros módulos", "BuildingFex.Api", "Usan IUserRepository, IUserCommand/ QueryService y CallerContext Accessor.")

Component(dm, "Domain Model", "Domain Layer", "User, Building Member, Member Invitation, Email; UserRoles, AccountStatus, IdentityProvider; IUserRepository.")
Component(ver, "FirebaseIdToken Verifier", "Adapter", "Valida el idToken (JWKS) en endpoints anónimos.")
Component(fadm, "FirebaseAuth AdminService", "Anticorruption Layer", "Custom claims (rol y ownerAdminId) y revocación.")
Component_Ext(billing, "Módulo Billing", "BuildingFex.Api", "ISubscription Service: límite de residentes.")
Component(repo, "UserRepository", "Repository (EF Core)", "IUserRepository sobre la tabla users.")

Component_Ext(dbctx, "AppDbContext", "EF Core compartido", "DbContext único de la API.")
ContainerDb(db, "TiDB Cloud", "MySQL compatible", "users, building_members, member_invitations.")
System_Ext(fbauth, "Firebase Authentication", "Correo y contraseña o Google.")

' --- rejilla 4 columnas (aristas invisibles)
Lay_R(spa, mw)
Lay_R(authCtrl, usersCtrl)
Lay_R(usersCtrl, memCtrl)
Lay_R(memCtrl, minvCtrl)
Lay_R(ucs, uqs)
Lay_R(uqs, cca)
Lay_R(cca, dbctx)
Lay_R(fadm, ver)
Lay_R(ver, dm)
Lay_R(dm, billing)
Lay_R(fbauth, repo)
Lay_R(repo, others)
Lay_R(others, db)
Lay_D(authCtrl, ucs)
Lay_D(ucs, fadm)
Lay_D(fadm, fbauth)
Lay_D(usersCtrl, uqs)
Lay_D(uqs, ver)
Lay_D(ver, repo)
Lay_D(memCtrl, cca)
Lay_D(cca, dm)
Lay_D(dm, others)
Lay_D(minvCtrl, dbctx)
Lay_D(dbctx, billing)
Lay_D(billing, db)

Rel(spa, authCtrl, "JSON/HTTPS")
Rel(spa, usersCtrl, "")
Rel(spa, memCtrl, "")
Rel(spa, minvCtrl, "")
Rel(mw, cca, "")
Rel(authCtrl, ucs, "")
Rel(authCtrl, cca, "")
Rel(usersCtrl, ucs, "")
Rel(usersCtrl, uqs, "")
Rel(memCtrl, cca, "")
Rel(memCtrl, dbctx, "")
Rel(minvCtrl, dbctx, "")
Rel(ucs, dm, "")
Rel(ucs, repo, "")
Rel(ucs, ver, "idToken")
Rel(ucs, fadm, "Claims")
Rel(ucs, billing, "Tope del plan")
Rel(uqs, repo, "")
Rel(cca, repo, "")
Rel_U(others, cca, "")
Rel_U(repo, dbctx, "")
Rel_D(dbctx, db, "")
Rel(ver, fbauth, "JWKS")
Rel(fadm, fbauth, "Admin SDK")
@enduml
