# Empty = same-origin; Vercel rewrites proxy to Railway (see vercel.json).
# Or set full URL with https:// (required — without it you get HTTP 405):
# VITE_API_BASE_URL=https://backend-production-5e544.up.railway.app
VITE_API_BASE_URL=

# Demo open access (any login/register + in-browser mock data). MUST stay false in
# production: with true the deployed app accepts any email/password and never calls the API.
# For a throwaway wireframe deploy use a separate preview env, never this file.
VITE_OPEN_WIREFRAMES=false

