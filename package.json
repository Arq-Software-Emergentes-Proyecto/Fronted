    "@capacitor/status-bar": "^7.0.6",
    "@mercadopago/sdk-js": "^0.0.3",
    "@microsoft/signalr": "^10.0.11",
    "@primevue/themes": "^4.2.5",
    "axios": "^1.16.0",
    "chart.js": "^4.5.1",
    "firebase": "^12.19.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.5",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
