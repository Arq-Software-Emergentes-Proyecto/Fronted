# BuildingFex API (no trailing slash)
# Development: leave empty to use Vite proxy (npm run dev + backend on :5001)
VITE_API_BASE_URL=

# Production: leave empty on Vercel (rewrites in vercel.json proxy to the API).
# On other hosts, use the full URL WITH https://:
# VITE_API_BASE_URL=https://backend-production-5e544.up.railway.app

# Mercado Pago Checkout Pro – access token (never prefix with VITE_)
# Put it in .env.development.local (gitignored) or Vercel env vars:
# MP_ACCESS_TOKEN=APP_USR-...

# Firebase (login de residente con Google)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# VITE_FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com

# Gemini (chat de soporte) — SOLO en el servidor BuildingFex.Api
# Nunca uses VITE_GEMINI_* (se embebe en el bundle del browser).
# En Railway / appsettings: Gemini__ApiKey o GEMINI_API_KEY
# Gemini__Model=gemini-2.0-flash

